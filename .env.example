# Required for Vercel API routes, GitHub Actions pipeline, and scripts.
DATABASE_URL=

# Required for email/password auth JWT signing in API routes.
JWT_SECRET=

# Required if API credit purchases are enabled.
PLATFORM_WALLET=

# Optional. Defaults to the public Solana mainnet RPC.
SOLANA_RPC_URL=

# Optional but recommended for economy/rates reference data.
FRED_API_KEY=

# Optional. Needed only for LLM classification runs.
ANTHROPIC_API_KEY=

# Optional. Needed only for alert emails.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
