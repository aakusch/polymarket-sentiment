{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/i/:id", "destination": "/api/indicators/:id/page" },
    { "source": "/embed/:id", "destination": "/api/embed/:id" },
    { "source": "/api/indicators/:id/page", "destination": "/api/indicators/:id?action=page" },
    { "source": "/api/keys", "destination": "/api/keys/__root" },
    { "source": "/api/alerts", "destination": "/api/alerts/__root" },
    { "source": "/api/v2/indicators", "destination": "/api/v2/indicators/__root" },
    { "source": "/api/v2/webhooks", "destination": "/api/v2/webhooks/__root" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "X-API-Key, Content-Type" }
      ]
    },
    {
      "source": "/api/v2/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "X-API-Key, Content-Type" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
